# Autonomous Equity & Options Strategist - Environment Configuration
# Copy this file to .env and configure your Google Gemini API credentials.

# Gemini API Key (either GOOGLE_API_KEY or GEMINI_API_KEY is accepted)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
# Defaults to gemini-2.5-flash (compatible with Flash 3.8 / 2.5 series)
GEMINI_MODEL=gemini-2.5-flash

# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*